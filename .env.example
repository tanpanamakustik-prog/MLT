# Port server (web + API jadi satu proses)
PORT=3335

# Kunci penandatangan JWT. WAJIB diganti sebelum dipakai di luar laptop.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Lokasi berkas database SQLite, relatif terhadap akar project.
DB_PATH=data/distribusihub.sqlite

# Titik pusat kantor/gudang untuk validasi radius absensi.
ABSENSI_LAT=-7.797068
ABSENSI_LNG=110.370529
ABSENSI_RADIUS_M=150
