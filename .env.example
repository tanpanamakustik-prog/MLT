# Port server (web + API jadi satu proses)
PORT=3335

# Kunci penandatangan JWT. WAJIB diganti sebelum dipakai di luar laptop.
JWT_SECRET=ganti-dengan-string-acak-panjang

# ---------------------------------------------------------------- Database
#
# Lokal: Postgres di mesin sendiri.
# Supabase: Dashboard > Connect > "Transaction pooler", yang PORT 6543.
#
# Wajib yang 6543, bukan 5432. Port 5432 adalah koneksi langsung: tiap fungsi
# serverless membuka koneksinya sendiri dan jatah koneksi project habis jauh
# sebelum lalu lintasnya ramai. Port 6543 lewat pooler yang memakai ulang
# koneksi — itulah yang dirancang untuk serverless.
DATABASE_URL=postgresql://ahmadwahyuaji@localhost:5432/mlt

# true untuk Supabase, false untuk Postgres lokal.
DB_SSL=false

# Kecil karena pooler-lah yang menampung koneksi sebenarnya; angka besar di sini
# hanya menumpuk koneksi menganggur yang ikut menghabiskan memori project.
DB_MAKS_KONEKSI=4

# Seluruh laporan berkunci pada tanggal lokal. Vercel dan Supabase berjalan di
# UTC, jadi zona ini dipasang di tiap koneksi, bukan diandalkan dari server.
ZONA_WAKTU=Asia/Jakarta

# Titik pusat kantor/gudang untuk validasi radius absensi.
ABSENSI_LAT=-7.797068
ABSENSI_LNG=110.370529
ABSENSI_RADIUS_M=150

# ------------------------------------------------------------ Alamat API
#
# Kosongkan untuk web: halaman dan API disajikan dari asal yang sama.
#
# WAJIB diisi saat build APK. Capacitor menyajikan berkas web dari
# http://localhost di dalam ponsel, jadi jalur relatif menunjuk ke ponsel itu
# sendiri dan tidak ada permintaan yang sampai ke server.
#
#   uji di jaringan rumah : http://192.168.x.x:3335
#   produksi              : https://nama-project.vercel.app
#
# Ini alamat publik, bukan rahasia.
VITE_API_BASE=

# ------------------------------------------------- Supabase (Storage & Auth)
#
# Dashboard > Project Settings > API keys.
#
# Supabase kini memakai dua nama untuk hal yang sama; pakai yang tampil di
# dashboard Anda:
#   publishable key  (dulu: anon key)      - boleh dilihat publik
#   secret key       (dulu: service_role)  - kunci penuh, melewati semua aturan
#
SUPABASE_URL=

# HANYA di server. Jangan pernah diberi awalan VITE_ — apa pun yang berawalan
# VITE_ ikut dibundel ke dalam berkas JavaScript yang diunduh setiap pengunjung,
# dan kunci ini membuka seluruh database tanpa batasan. Server menolak jalan
# bila menemukannya terbuka.
SUPABASE_SECRET_KEY=

# Boleh masuk bundel peramban; memang dirancang untuk itu.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nama bucket penyimpanan foto absensi dan bukti kirim.
SUPABASE_BUCKET=foto
